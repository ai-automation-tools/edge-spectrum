# Safe default: interactive tools and sample AI advice; no Gemini calls.
# Set to full only on your own instance to enable the live advisor.
EDGE_SPECTRUM_MODE=demo

# Full mode: add your own key on the server. Never prefix secrets with VITE_.
GEMINI_API_KEY=

# Full mode: use a strong, unique passcode to unlock the advisor in the browser.
ADVISOR_PASSCODE=

# Full mode: generate a long random signing secret. Changing it ends sessions.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADVISOR_SECRET=

# Local server only.
PORT=3001
