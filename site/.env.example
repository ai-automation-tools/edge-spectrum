# Safe default: interactive tools and sample AI advice; no Gemini calls.
# Set to full only on your own instance to enable the live advisor.
EDGE_SPECTRUM_MODE=demo

# Full mode: add your own key on the server. Never prefix secrets with VITE_.
GEMINI_API_KEY=

# Full mode, optional: the Gemini model the advisor calls. Leave unset for the
# default in site/src/server/advisor.ts; set it when Google retires that model
# before you have updated. Ids: https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=

# Full mode: use a strong, unique passcode to unlock the advisor in the browser.
ADVISOR_PASSCODE=

# Full mode, required: a long random signing secret. Without it the advisor stays
# off (503), the same as a missing passcode. Changing it ends sessions.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADVISOR_SECRET=

# Full mode, optional: advisor calls allowed per day across all visitors (default 200).
# Each session and each address also gets 10 an hour. These counters live in memory,
# so set a request quota on the Gemini key as the real ceiling.
# ADVISOR_DAILY_LIMIT=200

# Self-hosted Node server behind your own reverse proxy only: set to 1 so the
# rate limits read the visitor's address from X-Real-IP / X-Forwarded-For.
# Leave unset otherwise, or a visitor could fake the header. Vercel needs nothing.
# TRUST_PROXY=1

# Local server only.
PORT=3001

# Local server only: extra hostnames the dev server answers to, comma-separated.
# Needed when a proxy forwards another Host, e.g. `tailscale serve`:
# ALLOWED_HOSTS=my-pc,my-pc.tailnet-name.ts.net

# Line collector, optional: `npm run capture:lines -- --provider odds-api` reads your own
# The Odds API key (the-odds-api.com; free plan 500 credits a month, about 5 credits per sport
# per run). Not needed for the default ESPN collector. Never used by the site.
# ODDS_API_KEY=
