{
  "name": "edge-spectrum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "gen:edges": "tsx scripts/generate-edge-artifacts.ts",
    "check:market": "tsx scripts/check-market.ts",
    "check:spectrum": "tsx scripts/check-spectrum.ts",
    "check:odds": "tsx scripts/check-odds.ts",
    "check:stats": "tsx scripts/check-stats.ts",
    "check:strategy-url": "tsx scripts/check-strategy-url.ts",
    "check:edges": "tsx scripts/check-edges.ts",
    "check:deployment": "tsx scripts/check-deployment.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.4",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.2.3"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
