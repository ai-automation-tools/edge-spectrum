{
  "name": "edge-spectrum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "gen:edges": "tsx scripts/generate-edge-artifacts.ts",
    "check:market": "tsx scripts/check-market.ts",
    "check:engine": "tsx scripts/check-engine.ts",
    "check:spectrum": "tsx scripts/check-spectrum.ts",
    "check:odds": "tsx scripts/check-odds.ts",
    "check:stats": "tsx scripts/check-stats.ts",
    "check:strategy-url": "tsx scripts/check-strategy-url.ts",
    "check:calc-url": "tsx scripts/check-calc-url.ts",
    "check:edges": "tsx scripts/check-edges.ts",
    "check:lines": "tsx scripts/check-lines.ts",
    "check:live-grading": "tsx scripts/check-live-grading.ts",
    "capture:lines": "tsx scripts/capture-lines.ts",
    "digest:lines": "tsx scripts/digest-lines.ts",
    "build:registry": "node scripts/build-registry.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:deployment": "tsx scripts/check-deployment.ts",
    "check:spectrum-browser": "tsx scripts/check-spectrum-browser.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "vite": "^6.4.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "qs": "^6.17.0"
  }
